# Packaged driver output
build/

# Compiled Lua
luac.out

# Driver archives are build artefacts, not sources
*.c4z

# Captured device state — contains input labels and the unit's name
mso_*.json
*.capture.json

# Python bytecode. A .pyc embeds the ABSOLUTE PATH of its source at compile
# time, so committing one publishes the build machine's username and
# directory layout. tools/ is dev-only and never packaged, but this still must
# not be tracked.
__pycache__/
*.pyc

# Agent scratch: session ledgers and task reports. These carry absolute build
# paths from this machine. A nested .superpowers/sdd/.gitignore already ignores
# them, but that puts the protection inside the thing being protected -- name it
# here too, so it survives that file being moved or deleted.
.superpowers/
